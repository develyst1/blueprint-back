# Postgres connection URL, or pglite:memory for a local in-memory database
DATABASE_URL=
# Port the HTTP server listens on
PORT=4200
# Address to listen on: leave empty for this machine only; set 0.0.0.0 only on a server you have secured
HOST=
# Folder for uploaded originals; default ./data/sources
SOURCES_DIR=
# LLM Gateway base URL; default https://ai.develyst.online
GATEWAY_URL=
# Cheap model for light gateway calls (re-asks, corrections, quiz answers): tier:small or <provider>/<model>; empty = tier:small
GATEWAY_LIGHT_MODEL=
# CAW push notice after each confirm (http/https); empty = no outbound call — CAW reads GET /versions?after= instead
CAW_NOTIFY_URL=

# --- tests only ---
# Lets an exact list of local addresses (<host>:<port>[,<host>:<port>…]) through the private-address refusal; honoured only with DATABASE_URL=pglite:memory
# BLUEPRINT_LINK_TEST_ALLOW=
# 1 = run the one live LLM Gateway smoke test (GET /models + one POST /chat); unset = skipped
# BLUEPRINT_GATEWAY_LIVE=
# 1 = run the database rules test against the SIT Postgres in DATABASE_URL (rolled back, nothing committed); unset = skipped
# BLUEPRINT_SIT=
