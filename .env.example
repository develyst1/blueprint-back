# Postgres connection URL, or pglite:memory for a local in-memory database
DATABASE_URL=
# Port the HTTP server listens on
PORT=4200
# Address to listen on: leave empty for this machine only; set 0.0.0.0 only on a server you have secured
HOST=
# Folder for uploaded originals; default ./data/sources
SOURCES_DIR=
# LLM Gateway base URL; default https://ai.develyst.online
GATEWAY_URL=
# CAW push notice after each confirm (http/https); empty = no outbound call — CAW reads GET /versions?after= instead
CAW_NOTIFY_URL=
