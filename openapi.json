              "application/json": {
                "schema": {
                  "properties": {
                    "changeSetId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "changeSetId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "the undo, as a new change set"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
