                  ],
                  "type": "object"
                }
              }
            },
            "description": "this API's OpenAPI 3.1 document"
          }
        }
      }
    },
    "/v1/projects": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/Project"
                      },
                      {
                        "properties": {
                          "stuckCount": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "stuckCount"
                        ],
                        "type": "object"
                      }
                    ]
                  },
                  "type": "array"
                }
              }
            },
            "description": "every project, newest first"
          }
        }
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "organisationId": {
                    "type": "string"
                  },
                  "theme": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            }
          },
          "description": "a new project",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "description": "created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "validation"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "not_found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "too_large"
          }
        }
      }
    },
    "/v1/projects/{projectId}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "links": {
                      "items": {
                        "$ref": "#/components/schemas/Link"
                      },
                      "type": "array"
                    },
                    "parts": {
                      "items": {
                        "$ref": "#/components/schemas/Part"
                      },
                      "type": "array"
                    },
                    "project": {
                      "$ref": "#/components/schemas/Project"
                    }
                  },
                  "required": [
                    "project",
                    "parts",
                    "links"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "the live spec"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "not_found"
          }
        }
      }
    },
    "/v1/projects/{projectId}/change-sets": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "cause": {
                    "$ref": "#/components/schemas/Cause"
                  },
                  "changes": {
                    "items": {
                      "$ref": "#/components/schemas/Change"
                    },
                    "maxItems": 5000,
                    "type": "array"
                  }
                },
                "required": [
                  "cause",
                  "changes"
                ],
                "type": "object"
              }
            }
          },
          "description": "changes applied all or nothing",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "changeSetId": {
                      "type": "string"
                    },
                    "keys": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "type": "object"
                    }
                  },
                  "required": [
                    "changeSetId",
                    "keys"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "applied; temp refs → new keys"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "validation"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "not_found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "too_large"
          }
        }
      }
    },
    "/v1/projects/{projectId}/change-sets/{changeSetId}/undo": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "changeSetId",
            "required": true,
            "schema": {
